# Server
HOST=127.0.0.1
PORT=8080
APP_URL=
CORS_ORIGIN=*
ALLOWED_REDIRECT_DOMAINS=*.antigravity.google,claude.ai,claude.com,anthropic.com,chatgpt.com,chat.openai.com,openai.com,cursor.sh,cursor.com,windsurf.com,codeium.com,vscode.dev,github.dev,typingmind.com,dify.ai,coze.com,poe.com,mistral.ai,antigravity,cursor,vscode
MAX_FILE_SIZE_MB=10
UPSTREAM_TIMEOUT_MS=60000
OAUTH_TIMEOUT_MS=30000

# Database & Encryption at Rest (auto-creates <DB_PATH>.key locally; set 32-byte base64url key or <new>,<old> to override, or use systemd $CREDENTIALS_DIRECTORY/jump.key)
DB_PATH=./data.db
ENCRYPTION_KEY=

# SSO Domain Pinning (comma-separated domain:provider or domain:provider:strict)
SSO_DOMAINS=

# Google Cloud OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
